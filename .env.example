# Active website branding/festive theme
# Options: default | durga_puja | diwali | zda
NEXT_PUBLIC_THEME=default

# Contentful GraphQL Content Delivery API (CDA) Endpoint and Access Token
GRAPHQL_ENDPOINT=https://graphql.example.com/gql/v1
GRAPHQL_API_TOKEN=token

# Secret token for on-demand cache revalidation webhook
REVALIDATE_SECRET=your_secret_token_here
